---
import Layout from '../layouts/Layout.astro';
import SurveyGraphic from './SurveyGraphic.astro';
import Publication from './Publication.astro';
import { text, type Lang } from '../data/i18n';
import { profile } from '../data/profile';
import { photos } from '../data/photography';
const { lang } = Astro.props as { lang: Lang };
const t = text[lang];
const portrait = photos.find((photo) => photo.homepage);
const featuredPhoto = portrait ?? photos[0];
---

<Layout lang={lang} page="home">
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow">{t.subtitle}</p>
      <p class="hero-name">
        {lang === 'en' ? 'Rui Zhu' : '朱睿'}
        <span>{lang === 'en' ? '朱睿' : 'Rui Zhu'}</span>
      </p>
      <h1>
        {t.heroA}
        <br />
        <em>{t.heroB}</em>
      </h1>
      <p class="hero-intro">{t.intro}</p>
      <a class="button primary" href={`/${lang}/research/`}>
        {t.explore}
      </a>
      <div class="hero-affiliation">
        <span class="affiliation-line"></span>
        <div>
          {profile.role[lang]}
          <br />
          <span>{profile.affiliation[lang]}</span>
        </div>
      </div>
    </div>
    {portrait ? (
      <figure class="hero-portrait">
        <a
          href={`/${lang}/photography/#photo-${portrait.id}`}
          aria-label={
            lang === 'zh'
              ? `在摄影板块查看 ${portrait.title.zh}`
              : `View ${portrait.title.en} in Photography`
          }
        >
          <img
            src={portrait.thumb}
            srcset={portrait.sources.map((source) => `${source.src} ${source.width}w`).join(', ')}
            sizes="(max-width: 680px) min(100vw - 40px, 400px), (max-width: 900px) 42vw, 400px"
            width={portrait.width}
            height={portrait.height}
            alt={portrait.description[lang] || portrait.title[lang]}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </a>
      </figure>
    ) : (
      <SurveyGraphic lang={lang} />
    )}
  </section>
  <div class="interest-strip">
    <div class="container interest-inner">
      {profile.interests.map((interest, index) => (
        <span>
          <small>0{index + 1}</small>
          {interest[lang]}
        </span>
      ))}
    </div>
  </div>
  <section class="section container" id="qhsc">
    <div class="section-top">
      <p class="eyebrow">01 / {t.featured}</p>
      <span class="section-index">QHSC</span>
    </div>
    <div class="featured-grid">
      <div>
        <h2>{t.qhscHeading}</h2>
        <p class="section-description">{t.qhscIntro}</p>
        <a class="text-link" href={`/${lang}/research/#qhsc`}>
          {t.explore}
        </a>
      </div>
      <div class="research-metrics">
        <div>
          <strong>1,184,574</strong>
          <span>{t.candidates}</span>
        </div>
        <div>
          <strong>04</strong>
          <span>{t.samples}</span>
        </div>
        <div>
          <strong class="metric-small">HSC-SSP</strong>
          <span>
            {lang === 'zh' ? '第三次公开数据发布 · 宽层' : 'Public Data Release 3 · Wide layer'}
          </span>
        </div>
      </div>
    </div>
  </section>
  <section class="section container publication-section">
    <div class="section-top">
      <p class="eyebrow">02 / {t.selected}</p>
      <a class="text-link" href={`/${lang}/publications/`}>
        {t.allPapers}
      </a>
    </div>
    <Publication lang={lang} />
  </section>
  <section class="photo-teaser container">
    <div>
      <p class="eyebrow">03 / {t.beyond}</p>
      <h2>{t.photoTeaser}</h2>
      <p>{t.photoIntro}</p>
      <a class="button" href={`/${lang}/photography/`}>
        {t.gallery}
      </a>
    </div>
    {featuredPhoto ? (
      <a
        class="teaser-photo"
        href={`/${lang}/photography/#photo-${featuredPhoto.id}`}
        aria-label={
          lang === 'zh' ? `查看 ${featuredPhoto.title.zh}` : `View ${featuredPhoto.title.en}`
        }
      >
        <img
          src={featuredPhoto.thumb}
          width={featuredPhoto.width}
          height={featuredPhoto.height}
          alt={featuredPhoto.title[lang]}
          loading="lazy"
          decoding="async"
        />
      </a>
    ) : (
      <div class="teaser-side" aria-hidden="true">
        <span class="frame-corner top-left"></span>
        <span class="frame-corner top-right"></span>
        <span class="frame-corner bottom-left"></span>
        <span class="frame-corner bottom-right"></span>
        <span>PHOTOGRAPHY</span>
        <small>{lang === 'zh' ? '作品正在精选' : 'A COLLECTION IN THE MAKING'}</small>
      </div>
    )}
  </section>
</Layout>
