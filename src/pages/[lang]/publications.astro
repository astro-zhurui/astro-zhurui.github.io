---
import Layout from '../../layouts/Layout.astro';
import Publication from '../../components/Publication.astro';
import { text, languages, type Lang } from '../../data/i18n';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const t = text[lang];
---
<Layout lang={lang} page="publications" title={t.publications} description={t.publicationsIntro}>
  <section class="page-heading container"><p class="eyebrow">02 / {t.publications}</p><h1>{t.publicationsTitle}</h1><p>{t.publicationsIntro}</p></section>
  <section class="container publication-list"><div class="year-label">2026</div><Publication lang={lang} full /></section>
</Layout>
