{
  "name": "astro-zhurui-homepage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/validate-build.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "photos": "node scripts/prepare-photos.mjs",
    "test": "playwright test",
    "test:photos": "node scripts/test-photos.mjs",
    "format": "prettier --write src scripts tests *.ts *.mjs *.json",
    "format:check": "prettier --check src scripts tests *.ts *.mjs *.json"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.8",
    "astro": "7.3.7"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "latest",
    "@types/node": "^26.6.4",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "sharp": "latest",
    "typescript": "latest"
  }
}
