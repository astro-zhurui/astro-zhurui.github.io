---
import Layout from '../../layouts/Layout.astro';
import { profile } from '../../data/profile';
import { text, languages, type Lang } from '../../data/i18n';
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = text[lang];
---

<Layout lang={lang} page="about" title={t.about}>
  <section class="page-heading container">
    <h1>{t.aboutTitle}</h1>
    <p>{t.aboutSubtitle}</p>
  </section>
  <section class="container about-intro">
    <p class="biography">{profile.biography[lang]}</p>
    <div class="profile-links">
      <span class="eyebrow">{t.links}</span>
      <a href={profile.orcid} target="_blank" rel="noopener noreferrer">
        ORCID <span>0000-0002-0792-2353</span>
      </a>
      <a href={profile.github} target="_blank" rel="noopener noreferrer">
        GitHub <span>astro-zhurui</span>
      </a>
      {profile.cv[lang] && (
        <a href={profile.cv[lang]!} target="_blank" rel="noopener noreferrer">
          {t.cv}
          <span>PDF</span>
        </a>
      )}
    </div>
  </section>
  <section class="section container background">
    <h2>{t.background}</h2>
    <div class="timeline">
      {profile.experience.map((item) => (
        <article>
          <p class="eyebrow">{item.period}</p>
          <div class="institution-entry">
            <div class="institution-logo" aria-hidden="true">
              <img
                src={item.institution.logo}
                width="48"
                height="48"
                alt=""
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="institution-copy">
              <h3>
                <a href={item.institution.url} target="_blank" rel="noopener noreferrer">
                  {item.institution[lang]}
                </a>
              </h3>
              <p>{item[lang]}</p>
              <p class="institution-detail">{item.detail[lang]}</p>
              {item.supervisor && (
                <p class="institution-supervisor">
                  {lang === 'zh' ? '导师：' : 'Supervisor: '}
                  {item.supervisor[lang]}
                </p>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="contact-section container">
    <p class="eyebrow">{t.contactIntro}</p>
    <h2>{t.contact}</h2>
    <a class="contact-email" href={`mailto:${profile.email}`}>
      {profile.email}
    </a>
  </section>
</Layout>
