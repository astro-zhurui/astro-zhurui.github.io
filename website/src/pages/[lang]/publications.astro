---
import Layout from '../../layouts/Layout.astro';
import Publication from '../../components/Publication.astro';
import { publications } from '../../data/publications';
import { text, languages, type Lang } from '../../data/i18n';
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = text[lang];
const years = [...new Set(publications.map((paper) => paper.year))].sort((a, b) => b - a);
---

<Layout lang={lang} page="publications" title={t.publications} description={t.publicationsIntro}>
  <section class="page-heading container">
    <h1 lang="en">{t.publicationsTitle}</h1>
    <p>{t.publicationsIntro}</p>
  </section>
  <div class="container publications-by-year">
    {years.map((year) => (
      <section class="publication-list" aria-labelledby={`year-${year}`}>
        <h2 class="year-label" id={`year-${year}`}>
          {year}
        </h2>
        <div>
          {publications
            .filter((paper) => paper.year === year)
            .map((paper) => (
              <Publication lang={lang} publication={paper} full />
            ))}
        </div>
      </section>
    ))}
  </div>
</Layout>
