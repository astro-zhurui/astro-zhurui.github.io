---
import Layout from '../../layouts/Layout.astro';
import { languages, type Lang } from '../../data/i18n';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const zh = lang === 'zh';
const title = zh ? 'FXTC 对应体查询' : 'FXTC counterpart query';
const description = zh
  ? '用 FITS 星表或单源坐标查询 LS11 和 Gaia DR3 对应体。'
  : 'Search LS11 and Gaia DR3 for counterparts using a FITS catalogue or source coordinates.';
let gateway: URL | undefined;
try {
  const candidate = new URL(import.meta.env.PUBLIC_FXTC_WEB_URL || '');
  if (candidate.protocol === 'https:' && !candidate.username && !candidate.password) {
    gateway = candidate;
  }
} catch {
  // The portal link is enabled when an HTTPS address is configured.
}
---

<Layout lang={lang} page="fxtc" title={title} description={description}>
  <section class="page-heading container">
    <h1>{title}</h1>
    <p>{description}</p>
  </section>
  <section class="container portal">
    <div class="portal-card">
      <h2>{zh ? '开始查询' : 'Start a query'}</h2>
      <p>
        {zh
          ? '用已获授权的邮箱登录。提交后可在网页查看进度，并下载结果 ZIP。'
          : 'Sign in with an approved email address to submit a task, follow its progress, and download the result ZIP.'}
      </p>
      <div class="portal-actions">
        {
          gateway ? (
            <a class="button primary" href={gateway.href}>
              {zh ? '打开查询页' : 'Open the query portal'}
            </a>
          ) : (
            <p>{zh ? '网页查询暂未开放。' : 'Web queries are not open yet.'}</p>
          )
        }
        <a class="text-link" href={`/${lang}/about/`}>
          {zh ? '联系朱睿' : 'Contact Rui Zhu'}
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .portal {
    margin-block-end: 4rem;
  }
  .portal-card {
    max-inline-size: 46rem;
    border: 1px solid #d8e0e8;
    border-radius: 1rem;
    padding: clamp(1.2rem, 4vw, 2.35rem);
    background: white;
  }
  .portal-card h2 {
    margin-block-start: 0;
  }
  .portal-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.25rem;
  }
  @media (max-width: 34rem) {
    .portal-actions {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
