---
import Layout from '../../layouts/Layout.astro';
import { languages, type Lang } from '../../data/i18n';
import { previewOrigin } from '../../data/fxtc-preview';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const zh = lang === 'zh';
const title = zh ? 'FXTC 对应体查询' : 'FXTC counterpart query';
const description = zh
  ? '用 FITS 星表或单源坐标查询 LS11 和 Gaia DR3 对应体。'
  : 'Search LS11 and Gaia DR3 for counterparts using a FITS catalogue or source coordinates.';
let gateway: URL | undefined;
try {
  const candidate = new URL(import.meta.env.PUBLIC_FXTC_WEB_URL || previewOrigin);
  if (candidate.protocol === 'https:' && !candidate.username && !candidate.password) {
    gateway = candidate;
  }
} catch {
  // The portal link is enabled when an HTTPS address is configured.
}
---

<Layout lang={lang} page="fxtc" title={title} description={description}>
  <section class="page-heading container">
    <h1>{title}</h1>
    <p>{description}</p>
  </section>
  <section class="container portal">
    {
      gateway ? (
        <iframe
          title={title}
          data-fxtc-panel
          src={new URL('/?embed=1', gateway).href}
          sandbox="allow-scripts allow-same-origin allow-forms allow-downloads"
          referrerpolicy="no-referrer"
        />
      ) : (
        <div class="portal-card">
          <h2>{zh ? '网页查询暂未开放' : 'Web queries are not open yet'}</h2>
          <a class="text-link" href={`/${lang}/about/`}>
            {zh ? '联系朱睿' : 'Contact Rui Zhu'}
          </a>
        </div>
      )
    }
  </section>
</Layout>

<script>
  const panel = document.querySelector<HTMLIFrameElement>('[data-fxtc-panel]');
  if (panel) {
    const origin = new URL(panel.src).origin;
    window.addEventListener('message', (event) => {
      if (event.origin !== origin || event.source !== panel.contentWindow) return;
      const height = event.data?.fxtcHeight;
      if (typeof height === 'number' && Number.isFinite(height)) {
        panel.style.height = Math.min(2400, Math.max(300, Math.ceil(height))) + 'px';
      }
    });
  }
</script>

<style>
  .portal {
    margin-block-end: 4rem;
  }
  iframe {
    display: block;
    inline-size: 100%;
    max-inline-size: 46rem;
    height: 37rem;
    border: 0;
  }
  .portal-card {
    max-inline-size: 46rem;
    border: 1px solid #d8e0e8;
    border-radius: 1rem;
    padding: clamp(1.2rem, 4vw, 2.35rem);
    background: white;
  }
  .portal-card h2 {
    margin-block-start: 0;
  }
</style>
