---
import Layout from '../layouts/Layout.astro';
import { previewOrigin } from '../data/fxtc-preview';

const panelPath = '/?embed=1&lang=en&v=2';
const title = 'FXTC Counterpart Query Service';
const description =
  'Find candidate counterparts to EP–FXT sources in LS11 and Gaia DR3.';
let gateway: URL | undefined;
try {
  const candidate = new URL(import.meta.env.PUBLIC_FXTC_WEB_URL || previewOrigin);
  if (candidate.protocol === 'https:' && !candidate.username && !candidate.password) {
    gateway = candidate;
  }
} catch {
  // The portal link is enabled when an HTTPS address is configured.
}
---

<Layout lang="en" page="fxtc" title={title} description={description}>
  <div class="container fxtc-page">
    <header class="fxtc-header">
      <div class="intro">
        <h1>{title}</h1>
        <p>{description}</p>
        <p>Upload a FITS catalogue or enter the coordinates of a single source.</p>
      </div>
      <img src="/icons/fxtc-logo.png" alt="" width="84" height="84" />
    </header>
    <section class="portal" aria-label="Sign in and query">
      {
        gateway ? (
          <iframe
            title="FXTC sign-in and query form"
            data-fxtc-panel
            src={new URL(panelPath, gateway).href}
            sandbox="allow-scripts allow-same-origin allow-forms allow-downloads allow-popups allow-popups-to-escape-sandbox"
            referrerpolicy="no-referrer"
          />
        ) : (
          <div class="portal-card">
            <h2>Web queries are not open yet</h2>
            <a class="text-link" href="/en/about/">Contact Rui Zhu</a>
          </div>
        )
      }
    </section>
  </div>
</Layout>

<script>
  const panel = document.querySelector<HTMLIFrameElement>('[data-fxtc-panel]');
  if (panel) {
    const origin = new URL(panel.src).origin;
    window.addEventListener('message', (event) => {
      if (event.origin !== origin || event.source !== panel.contentWindow) return;
      const height = event.data?.fxtcHeight;
      if (typeof height === 'number' && Number.isFinite(height)) {
        panel.style.height = Math.min(2400, Math.max(250, Math.ceil(height))) + 'px';
      }
    });
  }
</script>

<style>
  .fxtc-page {
    max-inline-size: 54rem;
    padding-block: clamp(2rem, 5vw, 4.25rem) clamp(2rem, 4vw, 3.25rem);
  }
  .fxtc-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: clamp(1rem, 3vw, 2rem);
    padding-block-end: clamp(1.25rem, 3vw, 1.85rem);
    border-block-end: 1px solid var(--line);
  }
  .intro {
    display: grid;
    gap: 0.3rem;
  }
  .fxtc-header h1 {
    margin-block-end: 0.55rem;
    color: #172640;
    font-size: clamp(1.85rem, 4vw, 2.8rem);
    font-weight: 650;
    line-height: 1.13;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .intro p {
    max-inline-size: 58ch;
    line-height: 1.6;
  }
  .fxtc-header img {
    inline-size: clamp(3.5rem, 8vw, 5.25rem);
    block-size: auto;
    margin-block-start: 0.15rem;
  }
  .portal {
    margin-block-start: clamp(1.25rem, 3vw, 1.85rem);
    margin-inline: -0.24rem;
  }
  iframe {
    display: block;
    inline-size: 100%;
    height: 21rem;
    border: 0;
  }
  .portal-card {
    max-inline-size: 37rem;
    margin-inline: 0.24rem;
    padding: clamp(1rem, 4vw, 1.8rem);
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--surface);
  }
  .portal-card h2 {
    margin-block-end: 0.65rem;
  }
  @media (max-width: 520px) {
    .fxtc-header {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.85rem;
    }
    .fxtc-header img {
      grid-row: 1;
      margin-block-start: 0;
    }
  }
</style>
