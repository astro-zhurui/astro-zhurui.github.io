---
import Layout from '../layouts/Layout.astro';
import { previewOrigin } from '../data/fxtc-preview';

const panelPath = '/?embed=1&lang=en&v=2';
const title = 'FXTC counterpart query';
const description =
  'Search LS11 and Gaia DR3 for counterparts using a FITS catalogue or source coordinates.';
let gateway: URL | undefined;
try {
  const candidate = new URL(import.meta.env.PUBLIC_FXTC_WEB_URL || previewOrigin);
  if (candidate.protocol === 'https:' && !candidate.username && !candidate.password) {
    gateway = candidate;
  }
} catch {
  // The portal link is enabled when an HTTPS address is configured.
}
---

<Layout lang="en" page="fxtc" title={title} description={description}>
  <section class="container fxtc-header">
    <div class="fxtc-hero">
      <div>
        <p class="survey">EP–FXT · LS11 &amp; Gaia DR3</p>
        <h1>{title}</h1>
        <p class="intro-copy">{description}</p>
      </div>
      <img src="/icons/fxtc-logo.png" alt="FXTC" width="150" height="150" />
    </div>
  </section>
  <section class="container portal">
    {
      gateway ? (
        <iframe
          title={title}
          data-fxtc-panel
          src={new URL(panelPath, gateway).href}
          sandbox="allow-scripts allow-same-origin allow-forms allow-downloads allow-popups allow-popups-to-escape-sandbox"
          referrerpolicy="no-referrer"
        />
      ) : (
        <div class="portal-card">
          <h2>Web queries are not open yet</h2>
          <a class="text-link" href="/en/about/">Contact Rui Zhu</a>
        </div>
      )
    }
  </section>
</Layout>

<script>
  const panel = document.querySelector<HTMLIFrameElement>('[data-fxtc-panel]');
  if (panel) {
    const origin = new URL(panel.src).origin;
    window.addEventListener('message', (event) => {
      if (event.origin !== origin || event.source !== panel.contentWindow) return;
      const height = event.data?.fxtcHeight;
      if (typeof height === 'number' && Number.isFinite(height)) {
        panel.style.height = Math.min(2400, Math.max(300, Math.ceil(height))) + 'px';
      }
    });
  }
</script>

<style>
  .fxtc-header {
    padding-block-start: clamp(1.6rem, 5vw, 4rem);
  }
  .fxtc-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1rem, 4vw, 3.5rem);
    padding: clamp(1.3rem, 4.7vw, 3.8rem);
    color: #172640;
    background: linear-gradient(115deg, #fcfdff 31%, #e7eff9 100%);
    border: 1px solid #d8e3f0;
    border-radius: 1.35rem;
  }
  .fxtc-hero h1 {
    margin: .2em 0 .25em;
    color: inherit;
    line-height: 1.06;
    font-size: clamp(2.05rem, 5vw, 4.55rem);
    letter-spacing: -.055em;
  }
  .fxtc-hero .survey {
    color: #4a5e78;
    font-weight: 700;
    font-size: .875rem;
    letter-spacing: .1em;
  }
  .intro-copy {
    color: #435973;
    font-size: clamp(1rem, 2vw, 1.19rem);
    max-width: 34rem;
  }
  .fxtc-hero img {
    display: block;
    inline-size: clamp(4.2rem, 19vw, 9.4rem);
    block-size: auto;
  }
  .portal {
    margin-block: 1.25rem 4rem;
  }
  iframe {
    display: block;
    inline-size: 100%;
    height: 37rem;
    border: 0;
  }
  .portal-card {
    max-inline-size: 46rem;
    border: 1px solid #d8e0e8;
    border-radius: 1rem;
    padding: clamp(1.2rem, 4vw, 2.35rem);
    background: white;
  }
  .portal-card h2 {
    margin-block-start: 0;
  }
  @media (max-width: 500px) {
    .fxtc-hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .fxtc-hero img {
      grid-row: 1;
    }
  }
</style>
